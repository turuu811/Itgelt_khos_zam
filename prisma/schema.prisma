// Итгэлт Хос Зам ХХК: ачаа тээврийн систем
// Өгөгдлийн сангийн бүтэц, үе 1 (бүртгэл) + үе 2-т хэрэгтэй суурь
//
// Мөнгөний дүрэм:
//  - Дүнг "хамгийн бага нэгжээр" (BigInt) хадгална: 1 нэгж = валютын 1/100.
//    Жишээ нь 12,500.50 ¥ -> 1250050, 1,000,000 ₮ -> 100000000
//  - CNY гүйлгээнд fxRate (1 ¥ = хэдэн ₮) заавал оруулна, amountMntMinor-ийг
//    хадгалахдаа апп тооцоолно (amountMinor * fxRate).
//  - Гүйлгээг устгахгүй, зөвхөн VOID болгоно.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enum ─────────────

enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  WAREHOUSE
  CUSTOMER // үе 2
}

enum Currency {
  MNT
  CNY
}

enum CargoStatus {
  RECEIVED_ERLIAN // Эрээнд хүлээн авсан
  IN_WAREHOUSE // Агуулахад
  LOADED // Ачсан
  IN_TRANSIT // Замд
  AT_BORDER_CUSTOMS // Хил/гаальд
  ARRIVED_UB // УБ-д ирсэн
  DELIVERED // Хүлээлгэн өгсөн
  PROBLEM // Асуудалтай
  CANCELLED // Цуцлагдсан
}

enum TripStatus {
  PLANNED // Төлөвлөсөн
  IN_TRANSIT // Замд
  AT_BORDER // Хилд
  ARRIVED // Ирсэн
  CLOSED // Хаагдсан
}

enum TransactionType {
  INCOME // Орлого
  EXPENSE // Зарлага
  DRIVER_PAYMENT // Жолоочид олгосон
}

enum TransactionStatus {
  ACTIVE
  VOID // цуцалсан
}

enum PaymentMethod {
  CASH
  BANK
  WECHAT_ALIPAY
  OTHER
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// ───────────── Хэрэглэгч ба харилцагч ─────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Зөвхөн CUSTOMER эрхтэй хэрэглэгчид (үе 2). Өөрийн харилцагчийн ачааг л харна.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  statusChanges       CargoStatusHistory[]
  transactionsCreated Transaction[]        @relation("TransactionCreatedBy")
  transactionsVoided  Transaction[]        @relation("TransactionVoidedBy")
  attachments         Attachment[]
  auditLogs           AuditLog[]

  @@index([role])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  note          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cargo Cargo[]
  users User[]
}

// ───────────── Машин, жолооч, рейс ─────────────

model Vehicle {
  id                  String    @id @default(cuid())
  plateNumber         String    @unique
  type                String?
  capacityKg          Int?
  insuranceExpiresAt  DateTime?
  inspectionExpiresAt DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  trips Trip[]
}

// Жолооч системд нэвтэрдэггүй, зөвхөн бүртгэлийн объект.
model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips        Trip[]
  transactions Transaction[]
}

model Trip {
  id         String     @id @default(cuid())
  tripNumber String     @unique
  status     TripStatus @default(PLANNED)
  departAt   DateTime?
  arriveAt   DateTime?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  driverId  String
  driver    Driver  @relation(fields: [driverId], references: [id])

  cargo        Cargo[]
  transactions Transaction[]
  attachments  Attachment[]

  @@index([status])
  @@index([departAt])
}

// ───────────── Ачаа ─────────────

model Cargo {
  id          String      @id @default(cuid())
  trackCode   String      @unique
  description String?
  quantity    Int         @default(1)
  weightKg    Decimal?    @db.Decimal(12, 3)
  volumeM3    Decimal?    @db.Decimal(12, 3)
  status      CargoStatus @default(RECEIVED_ERLIAN)
  receivedAt  DateTime    @default(now())
  note        String?

  // Ачааны үнэ (сонголт), хамгийн бага нэгжээр
  priceMinor    BigInt?
  priceCurrency Currency?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id])

  history      CargoStatusHistory[]
  transactions Transaction[]
  attachments  Attachment[]

  @@index([status])
  @@index([customerId])
  @@index([tripId])
  @@index([receivedAt])
}

model CargoStatusHistory {
  id        String      @id @default(cuid())
  status    CargoStatus
  location  String?
  note      String?
  changedAt DateTime    @default(now())

  cargoId     String
  cargo       Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User   @relation(fields: [changedById], references: [id])

  @@index([cargoId, changedAt])
}

// ───────────── Санхүүгийн бүртгэл ─────────────

// Данс/касс: "Бэлэн ₮", "Бэлэн ¥", "Голомт данс", "WeChat" гэх мэт.
// Үе 1-д зөвхөн сонгох жагсаалт, үе 2-т үлдэгдэл тооцоолно.
model Account {
  id        String   @id @default(cuid())
  name      String
  currency  Currency
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  transactions Transaction[]
}

model Category {
  id        String          @id @default(cuid())
  name      String
  type      TransactionType
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id   String          @id @default(cuid())
  date DateTime
  type TransactionType

  // Дүн эх валютаар
  amountMinor BigInt
  currency    Currency
  // 1 CNY = хэдэн MNT. CNY гүйлгээнд заавал, MNT гүйлгээнд null.
  fxRate      Decimal? @db.Decimal(18, 6)
  // Ханшаар тооцсон ₮-ийн дүн (тайланд ашиглана)
  amountMntMinor BigInt

  method       PaymentMethod
  counterparty String? // хэнээс/хэнд
  note         String?

  status     TransactionStatus @default(ACTIVE)
  voidReason String?
  voidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tripId     String?
  trip       Trip?     @relation(fields: [tripId], references: [id])
  cargoId    String?
  cargo      Cargo?    @relation(fields: [cargoId], references: [id])
  // DRIVER_PAYMENT төрөлд жолоочийг заана
  driverId   String?
  driver     Driver?   @relation(fields: [driverId], references: [id])

  createdById String
  createdBy   User    @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  voidedById  String?
  voidedBy    User?   @relation("TransactionVoidedBy", fields: [voidedById], references: [id])

  attachments Attachment[]

  @@index([date])
  @@index([type, status])
  @@index([tripId])
  @@index([driverId])
  @@index([accountId])
}

// ───────────── Файл, хүсэлт, лог ─────────────

model Attachment {
  id         String   @id @default(cuid())
  fileKey    String // хадгалалтын сан дахь түлхүүр (S3/R2)
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  // Дараахын аль нэгэнд хавсаргана
  cargoId       String?
  cargo         Cargo?       @relation(fields: [cargoId], references: [id])
  tripId        String?
  trip          Trip?        @relation(fields: [tripId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

// Нүүр хуудсаас ирсэн үнийн санал хүсэлт
model Inquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String
  cargoType String?
  weightKg  Decimal?      @db.Decimal(12, 3)
  volumeM3  Decimal?      @db.Decimal(12, 3)
  message   String?
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// Нэмэх/засах/цуцлах бүх үйлдлийг бүртгэнэ. Зөвхөн нэмнэ, засахгүй.
model AuditLog {
  id        String   @id @default(cuid())
  action    String // жишээ: "transaction.create", "cargo.status_change"
  entity    String // жишээ: "Transaction"
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}
