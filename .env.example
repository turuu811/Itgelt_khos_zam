# PostgreSQL (docker-compose.yml-тэй таарна)
DATABASE_URL="postgresql://postgres:debugger@localhost:5432/transportation?schema=public"

# Сессийн cookie-г гарын үсэг зурах түлхүүр. 32+ тэмдэгт.
# Үүсгэх: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-of-32-plus-characters"

# Ачааны track кодын угтвар (IHZ-260921-K7M2P)
TRACK_PREFIX="IHZ"

# npm run db:seed үед үүсэх анхны админ
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="AdminPassword"
